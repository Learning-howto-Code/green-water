---
const videoEmbedUrl = "https://cdn.hackclub.com/019d3cf1-df73-7afb-a776-a0b14ffc0703/video.mp4";
---

<main class="page">
	<section class="card">
		<h1>ML Demo</h1>
		<!-- <p>Creme background with an embedded video link.</p> -->
		<div class="video-wrap">
			<iframe
				src={videoEmbedUrl}
				title="Embedded video"
				allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
				referrerpolicy="strict-origin-when-cross-origin"
				allowfullscreen
			></iframe>
		</div>
	</section>
</main>

<style>
	:root {
		--creme: #f7f0df;
		--text: #2b2318;
		--panel: #fff9ed;
		--edge: #d8c9a8;
	}

	.page {
		min-height: 100vh;
		margin: 0;
		background: radial-gradient(circle at 15% 15%, #fff7e8 0%, var(--creme) 45%, #efe3cc 100%);
		display: grid;
		place-items: center;
		padding: 24px;
		color: var(--text);
		font-family: Georgia, "Times New Roman", serif;
	}

	.card {
		width: min(900px, 100%);
		background: var(--panel);
		border: 1px solid var(--edge);
		border-radius: 18px;
		padding: 22px;
		box-shadow: 0 10px 24px rgba(43, 35, 24, 0.12);
	}

	h1 {
		margin: 0 0 8px;
		font-size: clamp(1.6rem, 2vw + 1rem, 2.4rem);
		line-height: 1.1;
	}

	p {
		margin: 0 0 16px;
		opacity: 0.85;
	}

	.video-wrap {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 9;
		border-radius: 12px;
		overflow: hidden;
		border: 1px solid var(--edge);
		background: #e7d9bf;
	}

	iframe {
		width: 100%;
		height: 100%;
		border: 0;
		display: block;
	}
</style>